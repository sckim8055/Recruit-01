{
  // ─────────────────────────────────────────────────────────────────────────────
  // 이 파일의 맨 위(최상위)  = 테스트 서버 (recruit.kimbbob.xyz, Worker 이름 recruit-test, 가짜 데이터만).
  //                         로컬 개발(start.bat, npx wrangler dev)도 이 최상위 설정을 쓴다 (APP_ENV 는 --var APP_ENV:dev 로 바꿈).
  // 아래 "env" → "production" = 운영 서버 (Worker 이름 recruit, 별도 D1·R2). 배포: npm run deploy:prod (docs/DEPLOY.md 3장).
  //
  // 주의 (Cloudflare 문서 https://developers.cloudflare.com/workers/wrangler/configuration/ "Non-inheritable keys"):
  //   vars · d1_databases · r2_buckets · ai · secrets 는 named environment(production)로 물려지지 않는다 → production 에 모두 다시 적었다.
  //   triggers · observability · assets · routes · workers_dev 는 물려지지만, 헷갈리지 않게 production 에 같은 값을 다시 적었다.
  //   최상위를 고치면 production 쪽도 같이 고쳐야 하는지 확인한다 (특히 vars 에 새 줄을 넣을 때).
  // 비밀값(ENC_KEY 등)은 이 파일에 적지 않는다 — npx wrangler secret put … (docs/DEPLOY.md).
  // REPLACE_WITH_… 로 시작하는 값은 일부러 틀린 값이다. 그대로 두면 npm run predeploy:* 가 배포를 막는다.
  // ─────────────────────────────────────────────────────────────────────────────
  "name": "recruit-test",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // 테스트 서버 주소. Custom Domain 방식: Cloudflare 가 DNS 레코드와 인증서를 자동으로 만든다 (kimbbob.xyz 가 같은 Cloudflare 계정에 있어야 함).
  // https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
  "routes": [{ "pattern": "recruit.kimbbob.xyz", "custom_domain": true }],
  // workers.dev 주소와 미리보기 주소를 끈다 — 켜 두면 Cloudflare Access(운영자만 접속)를 거치지 않는 두 번째 주소가 생긴다.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recruit-test",
      // npx wrangler d1 create recruit-test 가 보여 주는 database_id 로 바꾼다 (docs/DEPLOY.md 2-3).
      // (이 값이 바뀌면 로컬 개발 DB 도 새로 만들어진다 — 로컬 D1 은 이 id 로 저장된다. 로컬 데이터는 가짜뿐이라 괜찮다.)
      "database_id": "b5478ded-7948-436a-8e2d-91507bd5ad30",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "recruit-test-files" }],
  // 예약 작업 (T-12): 매시 정각에 한 번, 실행마다 정리 단계 하나만 한다 (무료 플랜 CPU·호출 수 한도 — docs/ARCHITECTURE.md 14절).
  // 어느 시각(UTC)에 어느 단계를 하는지는 src/lib/maintenance.ts 의 SCHEDULE. cron 은 계정당 5개까지라 하나만 쓴다.
  "triggers": { "crons": ["0 * * * *"] },
  // Workers Logs: 콘솔 줄(maint: …, error: …)을 대시보드에서 본다. 무료 플랜 하루 20만 줄·3일 보관
  // (https://developers.cloudflare.com/workers/observability/logs/workers-logs/).
  // invocation_logs = false: 요청마다 남는 자동 기록(주소·응답 등)은 남기지 않고 코드가 찍은 줄만 남긴다 (개인정보 최소화).
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
  // Workers AI 바인딩은 최상위(= 로컬 개발)에 두지 않는다: AI 는 로컬에서 흉내 낼 수 없고 항상 Cloudflare 계정으로 원격 호출한다
  // (https://developers.cloudflare.com/workers/local-development/). 로그인하지 않은 PC 의 start.bat 이 멈추지 않게 production 에만 켰다.
  // 테스트 서버에서도 쓰려면 docs/DEPLOY.md 6-5 를 본다.
  "vars": {
    "APP_ENV": "test",
    "APP_ORIGIN": "https://recruit.kimbbob.xyz",
    // 보내는 사람. Resend 에서 kimbbob.xyz 도메인 인증을 마친 뒤의 주소 (docs/DEPLOY.md 2-6).
    "MAIL_FROM": "Recruit <no-reply@kimbbob.xyz>",
    // 운영자 소유 도메인: 공고 연락처로 쓸 수 없다 (직업정보제공사업자 준수사항)
    "OPERATOR_DOMAINS": "kimbbob.xyz,kimbbob.com,nexthub.me",
    // 직업정보제공사업 신고번호. 비어 있으면 운영(production)에서 공고를 게재할 수 없다. 테스트 서버는 비워 둔다.
    "REGISTRATION_NO": "",
    // 기능 플래그: "on" 일 때만 켜진다. 켜기 전 조건은 docs/ARCHITECTURE.md 5장. 임의로 켜지 않는다.
    "FLAG_PRODUCTION_JOBS": "off",
    "FLAG_HEADHUNTER_POSTING": "off",
    "FLAG_RESUME_ZH_SUMMARY": "off",
    "FLAG_PAID_LABEL": "off",
    // 점검 모드: "on" 이면 관리자·로그인·/api/health 말고 모든 요청에 503 점검 안내 (docs/DEPLOY.md 6-2).
    "MAINTENANCE": "off",
    // 공고 현지화 엔진: claude · gemini · workers_ai 중 먼저 쓸 엔진. 비워 두면 claude → gemini → workers_ai 순서로
    // 키·바인딩이 있는 것을 쓴다. 키는 wrangler secret put ANTHROPIC_API_KEY / GEMINI_API_KEY 로 넣는다 (README).
    "LOCALIZE_ENGINE": "",
    // 엔진별 모델. 비워 두면 코드의 기본값(src/lib/localize/engines/*.ts 의 DEFAULT_*_MODEL)을 쓴다.
    "LOCALIZE_WORKERS_AI_MODEL": "",
    "LOCALIZE_GEMINI_MODEL": "",
    "LOCALIZE_CLAUDE_MODEL": "",
    // 정리 작업 하루 보고(개수만)를 받을 운영자 이메일. 비워 두면 보고 메일을 보내지 않는다 (README "자동 정리 작업").
    "OPS_EMAIL": "",
    // 남용 방지 한도 (src/lib/limits.ts, README "남용 방지 한도"). 0 이상의 정수. 비워 두면(또는 잘못된 값이면) 괄호 안의 기본값을 쓴다.
    // T-17: 보통은 여기를 고치지 않고 관리자 화면 → 사이트 설정 → "사용량 한도" 에서 바꾼다 (다시 배포할 필요 없음).
    // 관리자 화면에서 정한 칸이 여기 값보다 먼저다 (관리자 설정 → 이 값 → 기본값). 여기 값은 관리자 설정이 없는 칸에만 쓰인다.
    // 하루는 한국 시간 0시에 바뀐다. 0 을 넣으면 그 기능을 쓰지 않는다 (예: 자동 번역 끄기).
    "LOCALIZE_PER_COMPANY_DAY": "", // 기업당 하루 자동 번역 호출 (30) — 공고 현지화·다시 만들기·면접 요청 번역 미리 보기 합계
    "LOCALIZE_SITE_DAY": "",        // 사이트 전체 하루 자동 번역 호출 (500) — 모든 기업 + 관리자 엔진 비교
    "ADMIN_LOCALIZE_TEST_DAY": "",  // 관리자 한 사람당 하루 엔진 비교 (50) — 고른 엔진 하나마다 1
    "MAIL_PER_COMPANY_DAY": "",     // 기업당 하루 메일 (100) — 면접 요청·불합격 통보·담당자 초대
    "MAIL_SITE_DAY": "",            // 사이트 전체 하루 기업 메일 (1000) — 로그인 인증코드는 세지 않는다. Resend 무료 플랜은 하루 100통 (docs/DEPLOY.md 1장)
    "DRAFT_JOBS_PER_COMPANY": "",   // 기업당 작성 중인 공고 수 (20) — 게재 중·마감이 아닌 공고(초안·차단)
    // 조건 알림 (T-10, docs/ARCHITECTURE.md 17절). 비워 두면 괄호 안의 기본값. 위와 같이 관리자 설정이 먼저다 (알림 켜기/끄기도 관리자 화면에서).
    "ALERT_MAIL_SITE_DAY": "",      // 사이트 전체 하루 알림 메일 (40) — Resend 무료 플랜 하루 100통을 로그인 코드와 같이 쓴다. 0 = 알림 메일 끔
    "ALERT_SEND_PER_RUN": ""        // 예약 작업 한 번에 처리하는 알림 수 (8, 최대 10 — 무료 플랜 하위 요청 50개 안에 맞춘 값). 0 = 알림 메일 끔
  },

  "env": {
    // ─────────────── 운영 서버 ───────────────
    // 올리기 전 조건은 docs/DEPLOY.md 3장. npm run predeploy:prod 가 통과해야 npm run deploy:prod 가 진행된다.
    // 도메인을 정하면 이 구역의 REPLACE_WITH_PRODUCTION_DOMAIN 을 메모장의 "바꾸기"(Ctrl+H)로 한 번에 모두 바꾼다 (예: kimbbob.com).
    "production": {
      "name": "recruit",
      "routes": [{ "pattern": "REPLACE_WITH_PRODUCTION_DOMAIN", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "recruit-prod",
          // npx wrangler d1 create recruit-prod 가 보여 주는 database_id 로 바꾼다 (docs/DEPLOY.md 3장).
          "database_id": "REPLACE_WITH_PROD_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "recruit-prod-files" }],
      "triggers": { "crons": ["0 * * * *"] },
      "observability": { "logs": { "enabled": true, "invocation_logs": false } },
      // Workers AI (현지화 엔진의 마지막 순서). https://developers.cloudflare.com/workers/wrangler/configuration/ "Workers AI"
      "ai": { "binding": "AI" },
      // 이 비밀값이 서버에 없으면 wrangler deploy 가 실패한다 (https://developers.cloudflare.com/workers/configuration/secrets/ "secrets.required").
      // ANTHROPIC_API_KEY·GEMINI_API_KEY 는 선택이라 넣지 않았다.
      "secrets": { "required": ["ENC_KEY", "SESSION_PEPPER", "RESEND_API_KEY"] },
      "vars": {
        "APP_ENV": "production",
        "APP_ORIGIN": "https://REPLACE_WITH_PRODUCTION_DOMAIN",
        "MAIL_FROM": "Recruit <no-reply@REPLACE_WITH_PRODUCTION_DOMAIN>",
        "OPERATOR_DOMAINS": "REPLACE_WITH_PRODUCTION_DOMAIN,kimbbob.xyz,kimbbob.com,nexthub.me",
        // 직업정보제공사업 신고번호 (필수). 비어 있으면 공고를 게재할 수 없고 predeploy:prod 가 배포를 막는다.
        "REGISTRATION_NO": "",
        "FLAG_PRODUCTION_JOBS": "off",
        "FLAG_HEADHUNTER_POSTING": "off",
        "FLAG_RESUME_ZH_SUMMARY": "off",
        "FLAG_PAID_LABEL": "off",
        "MAINTENANCE": "off",
        "LOCALIZE_ENGINE": "",
        "LOCALIZE_WORKERS_AI_MODEL": "",
        "LOCALIZE_GEMINI_MODEL": "",
        "LOCALIZE_CLAUDE_MODEL": "",
        "OPS_EMAIL": "",
        "LOCALIZE_PER_COMPANY_DAY": "",
        "LOCALIZE_SITE_DAY": "",
        "ADMIN_LOCALIZE_TEST_DAY": "",
        "MAIL_PER_COMPANY_DAY": "",
        "MAIL_SITE_DAY": "",
        "DRAFT_JOBS_PER_COMPANY": "",
        "ALERT_MAIL_SITE_DAY": "",
        "ALERT_SEND_PER_RUN": ""
      }
    }
  }
}
