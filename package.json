{
  "name": "recruit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file=.env dist/server.mjs",
    "db:migrate": "node --env-file=.env scripts/db-migrate.mjs",
    "maint": "node scripts/build.mjs && node --env-file=.env dist/maint.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "import:cloudflare": "node --env-file=.env scripts/import-from-cloudflare.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predeploy:prod": "node scripts/predeploy.mjs production"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.1",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
