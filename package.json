{
  "name": "recruit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:local": "wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predeploy:test": "node scripts/predeploy.mjs test",
    "predeploy:prod": "node scripts/predeploy.mjs production",
    "deploy:test": "node scripts/deploy.mjs test",
    "deploy:prod": "node scripts/deploy.mjs production",
    "db:test:migrate": "node scripts/db-migrate.mjs test",
    "db:prod:migrate": "node scripts/db-migrate.mjs production",
    "backup:test": "node scripts/backup.mjs test",
    "backup:prod": "node scripts/backup.mjs production"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
