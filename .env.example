# recruit 서버 설정 (T-19). 이 파일을 복사해 같은 폴더에 .env 로 저장하고 값을 채운다 (docs/DEPLOY.md 3장).
# .env 는 git 에 올라가지 않는다 (.gitignore). 비밀값은 대화창·메일·git 에 붙여 넣지 않는다.
# 형식: 한 줄에 이름=값. 값에 공백이 있으면 큰따옴표로 감싼다. # 로 시작하는 줄은 설명.

# ── 실행 환경
# test = 지금의 recruit.kimbbob.xyz (개발·시연·시험을 함께, 가짜 데이터만). production = 나중의 운영 서버.
APP_ENV=test
APP_ORIGIN=https://recruit.kimbbob.xyz
# 서버가 듣는 포트. 127.0.0.1 에서만 열린다 (바깥에서는 Cloudflare Tunnel 로만). 방화벽에서 열지 않는다.
PORT=8787

# ── DB (PostgreSQL 16, 이 PC 의 5433 포트). recruit 계정의 비밀번호를 넣는다 (CHANGE_ME 를 바꾼다).
# 비밀번호에 @ : / # 같은 글자가 있으면 %40 %3A %2F %23 으로 바꿔 적는다 (DEPLOY.md 2장).
DATABASE_URL=postgres://recruit:CHANGE_ME@localhost:5433/recruit
# pg_dump 가 있는 폴더 (백업). 비우면 C:\Program Files\PostgreSQL\16\bin
PG_BIN=

# ── 파일 폴더 (코드 폴더 밖). 첨부파일은 DATA_DIR\files, 백업은 BACKUP_DIR (비우면 DATA_DIR\backups)
DATA_DIR=F:\works\Recruit-01-data
BACKUP_DIR=

# ── 비밀값. 예전 Cloudflare 테스트 서버의 데이터를 가져오므로 ENC_KEY·SESSION_PEPPER 는 **그 서버에 넣었던 값 그대로** 넣는다 (DEPLOY.md 3-1).
ENC_KEY=
SESSION_PEPPER=
# 메일 발송 (Resend). 없으면 아무도 로그인할 수 없다 (인증코드 메일).
RESEND_API_KEY=
MAIL_FROM="Recruit <no-reply@kimbbob.xyz>"
# 공고 현지화 엔진 (선택). Claude 가 기본, Gemini 는 선택. 둘 다 비우면 기업이 한국어를 직접 입력한다.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCALIZE_ENGINE=
LOCALIZE_CLAUDE_MODEL=
LOCALIZE_GEMINI_MODEL=

# ── 사이트 값
# 운영자 소유 도메인: 공고 연락처로 쓸 수 없다 (직업정보제공사업자 준수사항)
OPERATOR_DOMAINS=kimbbob.xyz,kimbbob.com,nexthub.me
# 직업정보제공사업 신고번호. 테스트 서버는 비워 둔다 (운영에서 비어 있으면 공고를 게재할 수 없다).
REGISTRATION_NO=
# 기능 플래그: "on" 일 때만 켜진다. 켜기 전 조건은 docs/ARCHITECTURE.md 5장. 임의로 켜지 않는다.
FLAG_PRODUCTION_JOBS=off
FLAG_HEADHUNTER_POSTING=off
FLAG_RESUME_ZH_SUMMARY=off
FLAG_PAID_LABEL=off
# 점검 모드: "on" 이면 관리자·로그인 말고 모두 점검 안내 (DEPLOY.md 9-1). 바꾼 뒤 서버를 다시 시작한다.
MAINTENANCE=off
# 시연 계정 로그인: 테스트 서버에서만 on. 운영은 off.
DEMO_LOGIN=on
# 정리 작업 하루 보고를 받을 운영자 이메일 (비우면 보내지 않음)
OPS_EMAIL=

# ── 남용 방지 한도 (비우면 기본값. 보통은 관리자 화면 → 사이트 설정 → "사용량 한도" 에서 바꾼다)
LOCALIZE_PER_COMPANY_DAY=
LOCALIZE_SITE_DAY=
ADMIN_LOCALIZE_TEST_DAY=
MAIL_PER_COMPANY_DAY=
MAIL_SITE_DAY=
DRAFT_JOBS_PER_COMPANY=
ALERT_MAIL_SITE_DAY=
ALERT_SEND_PER_RUN=

# ── 예약 작업·자동 백업
# 매시 정각의 정리 작업. 같은 DB 를 쓰는 서버를 하나 더 띄울 때만 off.
SCHEDULER=on
# 자동 백업 (매일 한국 시간 03시): on 이고 BACKUP_PASSPHRASE(12자 이상)가 있을 때만. 비밀문구가 이 파일에 남는다는 뜻이다 — DEPLOY.md 7-4.
BACKUP_AUTO=off
BACKUP_PASSPHRASE=
# 자동 백업을 몇 개까지 남길지 (오래된 것부터 지운다)
BACKUP_KEEP=14
